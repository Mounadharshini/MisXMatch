    {
      "name": "05. Missing Person Case Management",
      "description": "Report missing persons, retrieve active directory, update cases, manage investigation status and stats.",
      "item": [
        {
          "name": "Report Missing Person",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('missingCaseId', jsonData.id);",
                  "    pm.collectionVariables.set('missingCaseNumber', jsonData.caseNumber);",
                  "    pm.environment.set('missingCaseId', jsonData.id);",
                  "    pm.environment.set('missingCaseNumber', jsonData.caseNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Siddharth Joshi\",\n  \"age\": 16,\n  \"gender\": \"Male\",\n  \"height\": \"5 ft 6 in\",\n  \"complexion\": \"Fair\",\n  \"identifyingMarks\": \"Scar on chin, wears black rimmed spectacles\",\n  \"lastSeenLocation\": \"Kashmere Gate Metro Station, Delhi\",\n  \"lastSeenDate\": \"2026-08-09\",\n  \"photoUrl\": \"https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=400\",\n  \"description\": \"Wearing navy blue graphic hoodie and grey sweatpants. Carried a black sports duffel bag.\",\n  \"contactPhone\": \"+91 9876501234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cases/missing",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "missing"]
            }
          }
        },
        {
          "name": "List All Missing Persons (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cases/missing",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "missing"]
            }
          }
        },
        {
          "name": "List Missing Persons Filtered by Reporter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cases/missing?reportedBy=john_citizen",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "missing"],
              "query": [
                {
                  "key": "reportedBy",
                  "value": "john_citizen"
                }
              ]
            }
          }
        },
        {
          "name": "Get Missing Person by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cases/missing/{{missingCaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cases", "missing", "{{missingCaseId}}"]
            }
          }
        },
        {
          "name": "Update Missing Person Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
