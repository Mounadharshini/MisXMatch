# ==========================================
# MISXMATCH Platform - Database & Service Config
# ==========================================

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root

# Service Ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CASE_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# Service Hostnames (for Gateway routing)
AUTH_SERVICE_HOST=localhost
CASE_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_HOST=localhost

# JWT Configuration
JWT_SECRET=misxmatch-super-secret-signing-key-change-in-prod-2026-01

# OTP & Notifications
OTP_MODE=development
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAIL_FROM=no-reply@misxmatch.org
