# =========================================================================
# MISXMATCH AI PLATFORM — LOCAL & PRODUCTION ENVIRONMENT VARIABLE TEMPLATE
# Copy this file to '.env' before running docker compose or local services.
# DO NOT commit real production passwords or API secrets into version control.
# =========================================================================

# Database Configuration (MySQL 8.0)
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=root
MYSQL_DATABASE=misxmatch_db

# Security & Authentication (JWT Secret MUST be at least 32 characters in production)
JWT_SECRET=misxmatch-super-secret-signing-key-change-in-prod-2026-01

# AI Internal Microservice Inter-Service Key
AI_SERVICE_KEY=misxmatch-internal-ai-service-secret-key-2026

# OTP Verification Mode ('development' prints OTPs in console log, 'production' sends real emails)
OTP_MODE=development
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# CORS Security Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173,http://127.0.0.1:80

# Object Storage (MinIO / S3)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Mail / SMTP Configuration (Optional in development mode)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
OTP_MAIL_FROM=no-reply@misxmatch.org

# Runtime Environment ('development', 'staging', 'production')
ENV=development
